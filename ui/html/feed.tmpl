{{define "title"}}Feed — AITU Connect{{end}}

{{define "content"}}
<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="fw-bold mb-2">Campus Feed</h2>
        <p class="text-muted small mb-4">What's happening at AITU</p>

        
        <div id="createPostArea" class="card shadow border-0 mb-5 rounded-4" style="background: linear-gradient(135deg, #f5f7fa 0%, #ffffff 100%);">
            <div class="card-body p-5">
                <h5 class="fw-bold mb-4">✍️ Create New Post</h5>
                <form id="postForm">
                    <div class="mb-3">
                        <label for="postTitle" class="form-label text-muted small">Post Title</label>
                        <input type="text" id="postTitle" class="form-control border-0 bg-light py-3 shadow-sm" placeholder="Give your post a title..." required>
                    </div>
                    <div class="mb-4">
                        <label for="postContent" class="form-label text-muted small">Message</label>
                        <textarea id="postContent" class="form-control border-0 bg-light shadow-sm" rows="4" placeholder="Share your thoughts with the AITU community..." required></textarea>
                    </div>
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" id="cancelPostBtn" class="btn btn-outline-secondary px-5 rounded-pill fw-bold">Cancel</button>
                        <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm fw-bold">📤 Publish</button>
                    </div>
                </form>
            </div>
        </div>

        <div id="feedContainer">
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/static/js/feed.js"></script>
{{end}}

{{template "base" .}}