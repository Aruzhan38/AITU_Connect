{{define "title"}}Feed — AITU Connect{{end}}

{{define "content"}}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="fw-bold mb-0">Campus Feed</h2>
                <p class="text-muted small mb-0">What's happening at AITU</p>
            </div>
            <button id="togglePostBtn" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold d-none">
                + Create Post
            </button>
        </div>

        <div id="createPostArea" class="card shadow-sm border-0 mb-5 rounded-4 d-none">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">New Publication</h5>
                    <button type="button" class="btn-close" id="closePostBtn"></button>
                </div>
                <form id="postForm">
                    <div class="mb-3">
                        <input type="text" id="postTitle" class="form-control border-0 bg-light py-2 shadow-none" placeholder="Title" required>
                    </div>
                    <div class="mb-3">
                        <textarea id="postContent" class="form-control border-0 bg-light shadow-none" rows="3" placeholder="Write something..." required></textarea>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm fw-bold">Post</button>
                    </div>
                </form>
            </div>
        </div>

        <div id="feedContainer">
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/static/js/feed.js"></script>
{{end}}

{{template "base" .}}