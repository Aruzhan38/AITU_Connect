{{define "title"}}Community Feed — AITU Connect{{end}}

{{define "content"}}
<div class="container py-4" data-community-id="{{.CommunityID}}">
  <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
    <div>
      <h2 class="fw-bold mb-1" id="commTitle">Community Feed</h2>
      <p class="text-muted mb-0" id="commSubtitle">Posts inside this community</p>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-secondary" href="/communities">← Communities</a>
      <a class="btn btn-outline-secondary" href="/feed">Campus Feed</a>
    </div>
  </div>

  <div id="createPostArea" class="card shadow-sm border-0 mb-4 d-none">
    <div class="card-body p-4">
      <h5 class="fw-bold mb-3">Create post in this community</h5>
      <form id="postForm">
        <div class="mb-3">
          <input id="postTitle" class="form-control form-control-lg border-0 bg-light" placeholder="Title" required />
        </div>
        <div class="mb-3">
          <textarea id="postContent" class="form-control border-0 bg-light" rows="3" placeholder="What's on your mind?" required></textarea>
        </div>
        <div class="text-end">
          <button class="btn btn-primary px-5 fw-bold" type="submit">Post</button>
        </div>
      </form>
    </div>
  </div>

  <div id="feedContainer">
    <div class="text-center text-muted py-5">
      <div class="spinner-border text-primary mb-2" role="status"></div>
      <p>Loading community posts...</p>
    </div>
  </div>
</div>

<script src="/static/js/community_feed.js"></script>
{{end}}

{{template "base" .}}