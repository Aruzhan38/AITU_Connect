{{define "title"}}Moderator — AITU Connect{{end}}

{{define "content"}}
<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="fw-bold mb-1">Moderator Panel</h1>
    <p class="text-muted mb-0">Content moderation (canteens updates)</p>
  </div>
  <button id="refreshBtn" class="btn btn-outline-primary">Refresh</button>
</div>

<div id="modAlert" class="alert d-none" role="alert"></div>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <label class="form-label">Filter by canteen</label>
    <select id="canteenSelect" class="form-select">
      <option value="">All canteens</option>
    </select>
  </div>
  <div class="col-md-6">
    <label class="form-label">Search</label>
    <input id="searchInput" class="form-control" placeholder="Search title/content..." />
  </div>
</div>

<div id="newsList" class="vstack gap-3"></div>

<div id="emptyState" class="text-muted d-none">
  No news found.
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit news</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="editForm" class="row g-3">
          <input type="hidden" name="id" />

          <div class="col-md-6">
            <label class="form-label">Title</label>
            <input class="form-control" name="title" />
          </div>

          <div class="col-md-6">
            <label class="form-label">Price</label>
            <input class="form-control" name="price" placeholder="e.g. 600₸ or 600" />
            <div class="form-text">Tip: keep the same format everywhere.</div>
          </div>

          <div class="col-12">
            <label class="form-label">Content</label>
            <textarea class="form-control" name="content" rows="4"></textarea>
          </div>
        </form>
        <div id="editMsg" class="small text-muted mt-2"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button id="saveBtn" class="btn btn-primary">Save</button>
      </div>
    </div>
  </div>
</div>

<script src="/static/js/moderator.js"></script>
{{end}}

{{template "base" .}}