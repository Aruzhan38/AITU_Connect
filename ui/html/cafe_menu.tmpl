{{define "title"}}Cafe Menu — AITU Connect{{end}}
{{define "body_class"}}menu-page{{end}}

{{define "content"}}
<div class="d-flex align-items-start justify-content-between gap-3 mb-3">
  <div>
    <h1 class="fw-bold mb-1" id="placeName">Cafe</h1>
    <p class="text-muted mb-0" id="placeLocation">—</p>
  </div>

  <div class="d-flex align-items-center gap-2">
    <button class="btn btn-outline-secondary" id="btnClearCart" type="button">Clear</button>

    <button class="btn btn-primary position-relative" type="button" data-bs-toggle="offcanvas" data-bs-target="#cartCanvas">
      Saved
      <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-light" id="cartCount">0</span>
    </button>
  </div>
</div>

<div class="menu-sticky">
  <div class="menu-search-row">
    <div class="menu-search">
      <div class="input-group">
        <span class="input-group-text">🔎</span>
        <input class="form-control" id="searchInput" placeholder="Search in menu..." />
      </div>
    </div>
  </div>

  <div class="menu-cats" id="catBar"></div>
</div>

<div id="menuSections" class="mt-3"></div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="cartCanvas">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title fw-bold">Saved items</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body">
    <div class="vstack gap-2" id="cartList"></div>
    <div class="text-muted small mt-3" id="cartHint">Tap “+” to save items here.</div>
  </div>
</div>
{{end}}

{{define "scripts"}}
<script src="/static/js/cafe_menu.js?v=10"></script>
{{end}}

{{template "base" .}}